# Copy to ".env" to override the demo defaults used by docker-compose.yml.
# The stack works without this file; change these values outside a demo.

POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet

# Host ports (change if they are already taken on your machine)
DB_HOST_PORT=5433
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501

# Admin credential: X-API-Key for the API and password of user "admin" in the dashboard
ADMIN_API_KEY=admin-secret
# Password of user "analista" in the dashboard (masked vehicle ids)
ANALYST_UI_PASSWORD=analista

# Simulator and pipeline
SIM_INTERVAL_S=5
SIM_BACKFILL_MINUTES=120
PIPELINE_INTERVAL_S=10
